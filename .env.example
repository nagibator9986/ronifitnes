# Скопируйте в .env и подставьте свои значения
# Для Railway эти переменные задаются в Settings → Variables

# Любая длинная случайная строка — для подписи JWT и Flask-сессий
SECRET_KEY=replace-with-long-random-string
JWT_SECRET=replace-with-another-long-random-string

# Включить продакшн-режим (выключает CORS-открытость, debug)
FLASK_ENV=production

# Railway автоматически прокидывает DATABASE_URL когда подключаете PostgreSQL plugin.
# Если не задано — используется локальный SQLite файл.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Опционально: ограничить CORS только конкретными доменами (через запятую).
# Если не задано в production — разрешено всё.
# ALLOWED_ORIGINS=https://ronifitness.up.railway.app

# Опционально: куда сохранять загруженные пользователями файлы.
# На Railway без volume файлы исчезнут при редеплое — подключите Volume на /data
# и установите UPLOAD_DIR=/data/uploads
# UPLOAD_DIR=/data/uploads
