# Скопируйте в .env и подставьте свои значения.
# На Railway эти переменные задаются в Settings → Variables.

# Длинные случайные строки — для подписи Flask-сессий и JWT
SECRET_KEY=replace-with-long-random-string
JWT_SECRET=replace-with-another-long-random-string

# Продакшн-режим (выключает debug)
FLASK_ENV=production

# Railway автоматически прокидывает DATABASE_URL при подключении PostgreSQL.
# Если не задано — используется локальный SQLite (backend/illuminartai.db).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Опционально: ограничить CORS конкретными доменами (через запятую).
# ALLOWED_ORIGINS=https://illuminartai.up.railway.app

# Опционально: куда сохранять загруженные файлы.
# На Railway без volume файлы исчезнут при редеплое — подключите Volume
# и установите UPLOAD_DIR=/data/uploads
# UPLOAD_DIR=/data/uploads
